# Copy this file to ".env" and fill in your key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides — defaults shown:
# ELECTROGRADER_TEXT_MODEL=claude-sonnet-4-5
# ELECTROGRADER_VISION_MODEL=claude-sonnet-4-5

# Optional: BaseLinker (now Base.com) direct API push from the Export tab —
# an additional option alongside the existing CSV/Excel export, not a
# replacement. Leave all of these unset to keep using CSV/Excel only.
# Generate a token in the BaseLinker/Base.com panel: Account & other -> My
# account -> API. Find your inventory_id via the getInventories API method
# or the panel; category_id must be an existing category (addInventoryCategory).
# BASELINKER_API_TOKEN=
# BASELINKER_INVENTORY_ID=
# BASELINKER_CATEGORY_ID=
# Optional — only needed if your BaseLinker account has more than one price
# group / warehouse and you want price/stock sent automatically:
# BASELINKER_PRICE_GROUP_ID=
# BASELINKER_WAREHOUSE_ID=
# BASELINKER_TAX_RATE=23

# Copy this file to ".env" and fill in your key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides — defaults shown:
# ELECTROGRADER_TEXT_MODEL=claude-sonnet-4-5
# ELECTROGRADER_VISION_MODEL=claude-sonnet-4-5

# "development" (default) or "production". In production, the login
# session cookie gets the `Secure` flag (HTTPS-only) — see
# modules/auth_cookie.py for what this does and does not cover.
# ELECTROGRADER_ENV=development

# Required once any company connects an integration (Settings -> Integrations):
# encrypts stored integration credentials (API tokens etc.) at rest in the
# company_integrations table. Generate one key per environment with
# `python scripts/generate_encryption_key.py` and never rotate it without a
# re-encryption migration (existing rows become unreadable otherwise).
# ELECTROGRADER_ENCRYPTION_KEY=

# BaseLinker (now Base.com) and other marketplace/service integrations are
# now configured per-company from the app itself: Settings -> Integrations
# (admin-only). These BASELINKER_* env vars are only used as a one-time
# legacy seed by scripts/migrate_baselinker_env_to_integration.py — after
# that migration runs, edit the connection from Settings instead.
# BASELINKER_API_TOKEN=
# BASELINKER_INVENTORY_ID=
# BASELINKER_CATEGORY_ID=
# BASELINKER_PRICE_GROUP_ID=
# BASELINKER_WAREHOUSE_ID=
# BASELINKER_TAX_RATE=23
